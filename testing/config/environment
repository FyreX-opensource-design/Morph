# Morph runtime environment defaults
# This development environment file is sourced by testing/morph-session_dbg and can be linked into ~/.config/morph by scripts/dev-install.sh.
#
# Keep values commented unless you want to override launcher defaults.
# Effective launcher defaults still live in testing/morph-session_dbg.
#
# Modes:
#   MORPH_DBG=0 -> normal release run (error-level logging, crash handler off)
#   MORPH_DBG=1 -> release debug logging (info-level)
#   MORPH_DBG=2 -> debug logging + crash handler enabled

# Optional config override path. Empty means user -> system -> error.
#MORPH_CONFIG=/etc/morph/morph.conf

# Optional compatibility switch to allow synthesized builtin binds when no
# config file can be resolved anywhere.
#MORPH_ALLOW_BUILTIN_FALLBACK=1

# Debug mode selector (0,1,2)
MORPH_DBG=2

# Optional XDG lifecycle debug logs in compositor (0=off, 1=on)
MORPH_DEBUG_XDG=1

# wlroots/log verbosity helpers
WAYLAND_DEBUG=1
WLR_LOGTS=1

# Local wlroots runtime fallback (for systems without distro wlroots-0.20).
# Prefer system runtime libraries when available.
# Uncomment when morph-session runs from a display manager and cannot resolve
# libwlroots-0.20.so without shell-provided LD_LIBRARY_PATH.
#LD_LIBRARY_PATH="$HOME/.local/lib/x86_64-linux-gnu:$HOME/.local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Java/X11 compatibility helpers
_JAVA_AWT_WM_NONREPARENTING=1
#WMNAME=LG3D

# XKB defaults forwarded into compositor keyboard setup.
# Leave commented to use system defaults from libxkbcommon.
XKB_DEFAULT_LAYOUT=de,us
XKB_DEFAULT_MODEL=pc105
#XKB_DEFAULT_VARIANT=
# grp:alt_shift_toggle is typically Left Alt + Left Shift
XKB_DEFAULT_OPTIONS=grp:alt_shift_toggle

# X11 bridge controls (xwayland-satellite in compositor)
# Empty MORPH_X11 uses the enabled default in the launcher.
#MORPH_X11=0
#MORPH_X11_DISPLAY=:12

# Optional runtime log directory override (empty uses XDG_STATE_HOME fallback).
# Typically ~/.local/state/morph/
#MORPH_LOG_DIR=/var/log/morph
